{
  "name": "lattice-web",
  "private": true,
  "version": "0.0.0",
  "description": "lattice's web app: built to static files the lattice binary serves",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "mock": "node mock/server.mjs",
    "build": "vite build && vite build --config vite.export.config.ts",
    "preview": "node mock/server.mjs --app build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "perf": "node scripts/perf.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.4",
    "highlight.js": "11.11.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
