#!/bin/sh
# git's credential helper in lattice's container: a token for private
# repositories over HTTPS, on any git server, from the environment.
#
#   GIT_TOKEN       the token, given as the password
#   GIT_USERNAME    the user it's given with: x-access-token unless set,
#                   which GitHub takes; GitLab takes oauth2, Bitbucket
#                   x-token-auth, Gitea and Forgejo any name
#   GIT_TOKEN_HOST  the one host it's given to, like git.example.com;
#                   every host when it's not set
#
# It answers only `get`, only over HTTPS, and says nothing without a token,
# so git asks no one else and fails, as lattice runs it.

[ "${1:-}" = get ] || exit 0
[ -n "${GIT_TOKEN:-}" ] || exit 0
protocol=
host=
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
    esac
done
[ "$protocol" = https ] || exit 0
if [ -n "${GIT_TOKEN_HOST:-}" ] && [ "$host" != "$GIT_TOKEN_HOST" ]; then
    exit 0
fi
echo "username=${GIT_USERNAME:-x-access-token}"
echo "password=$GIT_TOKEN"
